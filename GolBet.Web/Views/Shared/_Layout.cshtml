
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - GolBet.Web</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GolBet.Web.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-success border-bottom mb-3">

            <div class="container">

                <!-- Logo -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    ⚽ GolBet
                </a>

                <!-- Botón responsive -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMain"
                        aria-controls="navbarMain"
                        aria-expanded="false"
                        aria-label="Mostrar menú">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="navbarMain">

                    <!-- Menú principal -->
                    <ul class="navbar-nav me-auto">

                        <!-- Inicio -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        <!-- Partidos -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Matches"
                               asp-action="Index">
                                Partidos
                            </a>
                        </li>

                        <!-- Equipos: solo administradores -->
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Teams"
                                   asp-action="Index">
                                    Equipos
                                </a>
                            </li>
                        }

                        <!-- Mis apuestas: solo apostadores -->
                        @if (User.IsInRole("Apostador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Bets"
                                   asp-action="MyBets">
                                    Mis apuestas
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- Información del usuario y sesión -->
                    <partial name="_LoginPartial" />

                </div>

            </div>

        </nav>
    </header>

    <!-- Contenido principal -->
    <div class="container">

        <main role="main" class="pb-3">

            <!-- Mensaje de éxito -->
            @if (TempData["Success"] is string message)
            {
                <div class="alert alert-success alert-dismissible fade show">

                    ✅ @message

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Cerrar">
                    </button>

                </div>
            }

            <!-- Mensaje de error -->
            @if (TempData["Error"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show">

                    ⚠️ @errorMessage

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Cerrar">
                    </button>

                </div>
            }

            @RenderBody()

        </main>

    </div>

    <!-- Pie de página -->
    <footer class="border-top footer text-muted">

        <div class="container">
            &copy; @DateTime.Now.Year - GolBet · Simulador académico
        </div>

    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
