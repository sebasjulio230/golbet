<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GolBet.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GolBet.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-success border-bottom mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    ⚽ GolBet
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Matches" asp-action="Index">Partidos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Teams" asp-action="Index">Equipos</a>
                        </li>
<!-- _Layout.cshtml, dentro del ul del navbar --> 

<li class="nav-item"> 

    <a class="nav-link" asp-controller="Teams" asp-action="Index">Equipos</a> 

</li> 

  

<!-- Matches/Index.cshtml: envolver el h2 en un d-flex (como en Teams) y agregar 
(En otras palabras, es reemplazar el h2 por el siguiente bloque de cod--> 

<div class="d-flex justify-content-between align-items-center mb-4"> 

    <h2>⚽ Cartelera de partidos</h2> 

    <a asp-action="Create" class="btn btn-success">+ Nuevo partido</a> 

</div> 

 

<!-- Matches/Detail.cshtml, en el card-footer reemplazo el card footer por este bloque de code --> 

    <div class="card-footer d-flex justify-content-between align-items-center"> 

        <small class="text-muted">🎟️ @Model.TotalBets apuestas realizadas</small> 

        <div> 

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Editar</a> 

            @if (Model.Status == MatchStatus.Scheduled) 

            { 

                <button class="btn btn-success" disabled 

                        title="Disponible cuando implementemos las apuestas"> 

                    Apostar (Módulo 8) 

                </button> 

            } 

        </div> 

    </div> 
                    </ul>
                    <!-- Aquí irá el enlace a Partidos (Módulo 3) y la sesión (Módulo 7) -->
                </div>
            </div>
        </nav>

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Success"] is string message) 

{ 

    <div class="alert alert-success alert-dismissible fade show"> 

        ✅ @message 

        <button type="button" class="btn-close" data-bs-dismiss="alert"></button> 

    </div> 

} <!-- _Layout.cshtml, dentro del ul del navbar --> 

<li class="nav-item"> 

    <a class="nav-link" asp-controller="Teams" asp-action="Index">Equipos</a> 

</li> 

  

<!-- Matches/Index.cshtml: envolver el h2 en un d-flex (como en Teams) y agregar 
(En otras palabras, es reemplazar el h2 por el siguiente bloque de cod--> 

<div class="d-flex justify-content-between align-items-center mb-4"> 

    <h2>⚽ Cartelera de partidos</h2> 

    <a asp-action="Create" class="btn btn-success">+ Nuevo partido</a> 

</div> 

 

<!-- Matches/Detail.cshtml, en el card-footer reemplazo el card footer por este bloque de code --> 

    <div class="card-footer d-flex justify-content-between align-items-center"> 

        <small class="text-muted">🎟️ @Model.TotalBets apuestas realizadas</small> 

        <div> 

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Editar</a> 

            @if (Model.Status == MatchStatus.Scheduled) 

            { 

                <button class="btn btn-success" disabled 

                        title="Disponible cuando implementemos las apuestas"> 

                    Apostar (Módulo 8) 

                </button> 

            } 

        </div> 

    </div> 
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - GolBet · Simulador académico
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
